01:22:04,040 --> 01:22:08,040
یا یہ کسی بھی مقابلہ ہے جو صرف مقابلہ ہے جو بہترین بیٹھنے کی قابل نہیں کرتا ہے؟

3915
01:22:08,040 --> 01:22:10,040
کراچی سے بہترین موڈل کی کسی ترقی کرنے کی کوئی مقابلہ ہے؟

3916
01:22:10,040 --> 01:22:14,040
یہ ایک بہترین بہترین بہترین سوال ہے۔

3917
01:22:14,040 --> 01:22:19,040
کہ جی انفرسٹر اکانومی جو ہے پاکستان میں کیوں نہیں چلتی؟

3918
01:22:19,040 --> 01:22:25,040
اور پھر انہوں نے مثال دی، مسٹر بیسٹ کے فیسٹیبلز کی، لوگن پال کے پرائم کی وغیرہ وغیرہ وغیرہ۔

3919
01:22:25,040 --> 01:22:32,040
اچھا پرائم کا کیس یہ ہے، مجھے یاد ہے، ہم نیویورک میں تھے، میری بیوی اور بیوی۔

3920
01:22:32,040 --> 01:22:43,040
اور میری بہترین بیوی، اس نے ہمارا، میں تو خیر ہے اس کو اس طرح نہیں دیکھتا، لیکن میری بیوی بھی ایسی طرح ایمپلینٹس کے بارے میں ہے۔

3921
01:22:43,040 --> 01:22:51,040
کہ وہ، روئنڈ ایسا بہترین بیوی ہے، لیکن وہ ہمارے لئے بہت زیادہ مشکل کرنے کے لئے بہت زیادہ مشکل کرنے کے لئے،

3922
01:22:51,040 --> 01:22:55,040
کیونکہ وہ ہر کھانے میں گھسڑا تھا اور پوچھ رہا تھا پرائم ہے کی نہیں ہے۔

3923
01:22:55,040 --> 01:23:00,040
کیونکہ وہ پرائم کی پہلی ویوی تھی اور سکول میں جس کے پاس پرائم ہے اس کی واو ہے۔

3924
01:23:00,040 --> 01:23:05,040
اور طبعاً جیسا کہ جنہوں نے پرائم ہے تو وہ اپنے بیوی کی طرف سے بھی چاہتا ہے۔

3925
01:23:05,040 --> 01:23:09,040
کیونکہ سب کچھ چاہتا ہے، خاص طور پر سوشل میڈیا کے بعد بہت اہم ہوگا۔

3926
01:23:09,040 --> 01:23:13,040
لہذا وہ اپنے بیوی کی طرف سے بھی چاہتا ہے، اور اس کا بھی کچھ بزنس منڈ سیٹ ہے۔

3927
01:23:13,040 --> 01:23:18,040
وہ چاہتا تھا کہ میں پانچ ڈالر کا خریدوں اور پچاس ڈالر کا وہاں یوکے میں پاؤنڈ کا بیچوں۔

3928
01:23:18,040 --> 01:23:20,040
اور ایسا ہو رہا تھا یوکے میں۔

3929
01:23:20,040 --> 01:23:24,040
ایسا کہ لوگوں نے اس کے لئے ٹاپ ڈالر پیش کر رہے تھے۔

3930
01:23:24,040 --> 01:23:26,040
لہذا اس طرح وہاں تھا کیونکہ سکیرسٹی ہے۔

3931
01:23:26,040 --> 01:23:28,040
پہلے ہی بولا ہے کہ قریب ہے۔

3932
01:23:28,040 --> 01:23:33,040
بہت سارے پاکستان میں بھی اس طرح کرتے ہیں کہ یہ صرف ہزار چھوٹے ہی بنائے ہیں۔

3933
01:23:33,040 --> 01:23:35,040
مثلاً، یہ پانی کی بوتل ہے۔

3934
01:23:35,040 --> 01:23:42,040
یہ ہائیڈریشن ہے، یہ آئس لینڈ کا، لیٹس سی، سکرڈو کے وارٹر فال کا پیوریفائیڈ پانی ہے۔

3935
01:23:42,040 --> 01:23:43,040
بس صرف ہزار بوتل ہیں۔

3936
01:23:43,040 --> 01:23:46,040
لہذا جب آپ سکیرسٹی کرتے ہیں تو پھر لوگ ذرا پاگل ہوتے ہیں۔

3937
01:23:46,040 --> 01:23:47,040
یار، میں اس کے لئے ہے۔

3938
01:23:47,040 --> 01:23:49,040
مثلاً، لبوبو تھا۔

3939
01:23:49,040 --> 01:23:51,040
لبوبو میں، کریز پتہ ہے کیا تھا؟

3940
01:23:51,040 --> 01:23:54,040
لبوبو کا کریز یہ تھا کہ ڈبے کے اندر کون سے رنگ ہے پتہ ہی نہیں ہے۔

3941
01:23:54,040 --> 01:23:56,040
یہ ہی تو کریز تھا۔

3942
01:23:56,040 --> 01:23:57,040
گیمبل تھا۔

3943
01:23:57,040 --> 01:24:01,040
دیکھو، گیمیفیکیشن میں چائنیز بہت حرامی ہیں۔

3944
01:24:01,040 --> 01:24:05,040
کیونکہ انہیں گیمبلر ہیں۔

3945
01:24:05,040 --> 01:24:06,040
گیمبلر ایک بہت زیادہ ورد ہے۔

3946
01:24:06,040 --> 01:24:08,040
انہیں گیمبلنگ پسند کرتے ہیں۔

3947
01:24:08,040 --> 01:24:12,040
تو کسینوز دنیا بر میں آپ کہیں جائیں، وہ چائنیز اپنے لئے ہی بناتے ہیں۔

3948
01:24:12,040 --> 01:24:16,040
مکاؤ انہوں نے بنایا ہی اس لئے کیونکہ چائنہ میں گیمبلنگ اللیگل ہے۔

3949
01:24:16,040 --> 01:24:19,040
یا پھر جنٹنگ ہائی لینڈز ملیشیا میں۔

3950
01:24:19,040 --> 01:24:25,040
لہذا، سرپرائز ایلیمنٹ، وہ جو ہے نا، وہ آپ کا ڈوپامین بڑھاتا ہے۔

3951
01:24:25,040 --> 01:24:29,040
لہذا، جیسے ٹیمو پہ اگر آپ شاپ کریں۔

3952
01:24:29,040 --> 01:24:39,040
تو ٹیمو پہ آپ جیسی ایپ پہ جائیں گے، تو آنا چاہیے بھئی یہ فوڈ ہے، یہ گروسریز ہیں، یہ آپ کا ٹیک کا سیکشن ہے۔

3953
01:24:39,040 --> 01:24:41,040
اس پہ پہلے آ جاتا ہے، سپن ڈا ویل۔

3954
01:24:41,040 --> 01:24:44,040
سپن ڈا ویل آپ کرتے ہو، چلو جی آپ نے پانچ سو روپے بچت کی لئے۔

3955
01:24:44,040 --> 01:24:49,040
ابھی آپ نے شاپنگ شروع کی نہیں ہے اور اس نے آپ کو بول دیا کہ تین پروڈکٹس فری دے رہا ہوں۔

3956
01:24:49,040 --> 01:24:53,040
اب آپ بولتے ہو، یار یہ تو مجھے صرف پئیہ گھومانے پہ مل گیا۔

3957
01:24:53,040 --> 01:24:58,040
اب آپ دھڑا دھڑ کرتے ہو کہ تین چیزیں ملیں گی اگر چار ہزار کی شاپنگ کرو گی۔

3958
01:24:58,040 --> 01:25:03,040
ٹھیک ہے، تو آپ چار ہزار کو پورا کرنے کے لئے دس چیزیں خرید لیتے ہو۔

3959
01:25:03,040 --> 01:25:06,040
تو وہ کہتے ہو ٹھیک ہے، دس اور تین تیرہ، تیرہ چیزیں آ گئے۔

3960
01:25:06,040 --> 01:25:10,040
جیسا کہ اس کا کاؤسٹ سیڈز میں ہوتی ہے لیکن وہ آپ کو آٹھ دس ہزار کا بل بنا دیتے ہیں۔

3961
01:25:10,040 --> 01:25:14,040
ٹھیک ہے، تو گیمی فیکیشن میں جو ہے نا بہت بہت ماہر ہیں چائنیز۔

3962
01:25:14,040 --> 01:25:17,040
تو لبوبو یہی تھا، پتہ ہی نہیں ہے ڈبے کے اندر کون سے رنگ کا ہے۔

3963
01:25:17,040 --> 01:25:23,040
کوئی یونیک لبوبو تو نہیں ہے کیونکہ ایسے بھی لبوبوز گزرے ہیں جو ہزاروں ڈالرز میں بکے ہیں۔

3964
01:25:23,040 --> 01:25:24,040
کیونکہ وہ ریئر تھے۔

3965
01:25:24,040 --> 01:25:31,040
جیسا کہ کوئی اس کلر کا یا کسی کی آنکھیں ایسی تھیں، سپارکلنگ آئیز یا فلانا نمکانا۔

3966
01:25:31,040 --> 01:25:34,040
تو ہاں، اسی طرح پر پرائم میں بھی انہوں نے سکیر سیٹی موڈل اپنایا۔

3967
01:25:34,040 --> 01:25:36,040
اوہ، آپ کو یہاں رکھنے کی ضرورت ہے۔

3968
01:25:36,040 --> 01:25:39,040
اور جو ہے سپلائیز روک کے رکھیں۔

3969
01:25:39,040 --> 01:25:45,040
اور دراصل انگلینڈ میں ٹیسکو کے ویر ہاؤزز میں بچوں نے چوریاں بھی کی ہیں۔

3970
01:25:45,040 --> 01:25:48,040
ڈاکے مار رہے ہیں، صرف اس چکر میں۔

3971
01:25:48,040 --> 01:25:52,040
کیونکہ ظاہر ہے ایک چیز سٹریٹ پر اتنی مہنگی بکری ہے۔

3972
01:25:52,040 --> 01:25:53,040
لہذا لوگوں کو یہاں رکھنے کی ضرورت ہے۔

3973
01:25:53,040 --> 01:25:58,040
لیکن جب اس کا ختم ہوئی، اب دکانوں میں رکھا ہوتا ہے۔

3974
01:25:58,040 --> 01:26:00,040
کوئی دیکھتا بھی نہیں ہے، کوئی پوچھتا بھی نہیں ہے۔

3975
01:26:00,040 --> 01:26:02,040
لہذا، یہ ایک چیز ہے۔

3976
01:26:02,040 --> 01:26:07,040
اب دیکھو میری شکل پر، اگر کل کو میں کوئی پروڈکٹ ریلیس کرتا ہوں، لیٹس سی، یہ لائٹ ہے۔

3977
01:26:07,040 --> 01:26:09,040
اوکے، یہ میں ریلیس کرتا ہوں۔

3978
01:26:09,040 --> 01:26:14,040
اوہ می گاڈ، کل کوئی لائٹ ہے، کیا اس کے فیچرز ہیں وغیرہ وغیرہ۔

3979
01:26:14,040 --> 01:26:18,040
اول تو، چلے لائٹ تو ایک بڑی چیز ہے نا۔

3980
01:26:18,040 --> 01:26:22,040
کوفی، کوفی کا برینڈ میں ریلیس کرتا ہوں۔

3981
01:26:22,040 --> 01:26:26,040
تو محبت میں آپ ایک بار تو لے لوگے، جنید بھائی نے بولا ہے تو لے لیتے ہیں۔

3982
01:26:26,040 --> 01:26:29,040
لیکن اگر کوفی اچھی نہیں ہوگی تو آپ دوسری بار نہیں لے لگے۔

3983
01:26:29,040 --> 01:26:31,040
لہذا، یہ نہیں ہوگی، یہ صرف فیس نہیں ہوگی۔

3984
01:26:31,040 --> 01:26:33,040
فیس پر آپ ایک بار آگے نا۔

3985
01:26:33,040 --> 01:26:37,040
اب جیسے مجھے سمجھ نہیں آتا ہے، جیسے ہیری پاٹر تھیم ریسٹورانٹس ہوتے ہیں۔

3986
01:26:37,040 --> 01:26:41,040
اسلام آباد میں کسی نے گیم آف تھرونز کے تھیم کا ریسٹورانٹس کھڑا۔

3987
01:26:41,040 --> 01:26:45,040
اب گیم آف تھرونز ایک مقصد وقت کے لیے ہے اور اس کا مقصد مقصد رہے گا۔

3988
01:26:45,040 --> 01:26:48,040
ساری زندگی آپ گیم آف تھرونز نہیں رکھو گے،

3989
01:26:48,040 --> 01:26:51,040
لیکن آپ سمجھ رہے ہوگے، نئے شوز آئیں گے، آپ ادھر نکل جاؤ گے۔

3990
01:26:51,040 --> 01:26:53,040
آپ ایسی طرح شوز میں نہیں رکھیں گے۔

3991
01:27:03,040 --> 01:27:05,040
ایک دن تو میں کر لوں گا۔

3992
01:27:05,040 --> 01:27:10,040
لیکن انحیرنٹی وہ ایک ریسٹورانٹس ہے جہاں کھانا اچھا ہونا چاہیے۔

3993
01:27:10,040 --> 01:27:12,040
تو اچھا کھانا ہوگا تو دوسری بار جاؤں گا۔

3994
01:27:12,040 --> 01:27:14,040
میں بار بار گیم آف تھرونز کے لیے تھوڑی جاؤں گا۔

3995
01:27:14,040 --> 01:27:18,040
تو سمیلرلی میری شکل پر آپ پروڈکٹ ایک بار تو لے لیں گے میری محبت میں۔

3996
01:27:18,040 --> 01:27:20,040
لیکن اگر پروڈکٹ اچھی نہیں ہوگی تو آپ دوسری بار کبھی بھی نہیں لے گے۔

3997
01:27:20,040 --> 01:27:22,040
کیونکہ پیسے ضائع کرنے والی بات ہے نا۔

3998
01:27:22,040 --> 01:27:24,040
تو اس چیز پر فوکس نہیں ہوتا۔

3999
01:27:24,040 --> 01:27:28,040
فوکس ہوتا ہے یار رجب پٹی کی فوٹو لگی ہوئی ہے تو بکے گئے ہی بکے گا۔

4000
01:27:28,040 --> 01:27:30,040
ہاں ایک بار بکے گا۔

4001
01:27:30,040 --> 01:27:31,040
دوسری بار نہیں بکے گا۔

4002
01:27:31,040 --> 01:27:34,040
دوسری بار تب ہی بکے گا جب چیز واقعی اچھی ہوگی۔

4003
01:27:34,040 --> 01:27:35,040
جنونلی اچھی ہوگی۔

4004
01:27:35,040 --> 01:27:38,040
تو اس چیز پر فوکس نہیں ہوتا۔

4005
01:27:38,040 --> 01:27:42,040
فوکس صرف اس پر ہوتا ہے کہ چلو میری شکل پر بکے گا۔

4006
01:27:42,040 --> 01:27:53,040
لیٹس اگر پاکستان میں پانچ کروڑ تینیجرز ہیں یا پانچ کروڑ جو ہیں سارے باکسز چیک کرتے ہیں کہ وہ اس ایج براکٹ کے ہیں۔

4007
01:27:53,040 --> 01:27:57,040
ایکانومک سوشل بیک گراؤنڈ یہ ہے وغیرہ وغیرہ افورڈیبلیٹی وغیرہ۔

4008
01:27:57,040 --> 01:28:01,040
تو اگر ایک نے دوسری بار نہیں بھی لیا تو پانچ کروڑ کی مارکٹ ہے۔

4009
01:28:01,040 --> 01:28:05,040
پانچ لاکھ لوگ بھی لے میرا پروڈکٹ اور ہزار روپے کا ایک پروڈکٹ ہو۔

4010
01:28:05,040 --> 01:28:08,040
تو مطلب پچاس کروڑ ہو گئے میرے۔

4011
01:28:08,040 --> 01:28:10,040
ایسا ہی ہوا؟

4012
01:28:10,040 --> 01:28:12,040
ہاں جو بھی۔

4013
01:28:12,040 --> 01:28:20,040
تو لوگ اس طرح دیکھتے ہیں اور ہمارے ہاں یہی ہمیں کوالٹی نہیں دینی ہم جو جو مارکٹ میں بھی کہتے ہیں باجی لینے تو لوگ اڑنا آگے جاؤ۔

4014
01:28:20,040 --> 01:28:26,040
کیونکہ ہماری یہ ہے یہ جائے گی پیچھے پانچ سو اور عورتیں آ رہی ہیں خلی ولی نہ بھی آئے بھاڑ میں میں بھوکا توڑی مروں گا۔

4015
01:28:26,040 --> 01:28:28,040
تو یہ اپروش تو غلط ہے نا۔

4016
01:28:28,040 --> 01:28:31,040
اچھی چیز ہوگی تو ہی لوگ بار برائیں گے۔

4017
01:28:31,040 --> 01:28:35,040
