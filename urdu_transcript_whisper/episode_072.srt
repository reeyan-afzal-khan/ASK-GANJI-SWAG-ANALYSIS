01:00:39,600 --> 01:00:40,960
مشکل کر دو کہ لوگ بھاگے

2104
01:00:40,960 --> 01:00:42,500
اور جو لوگ بھاگے

2105
01:00:42,500 --> 01:00:44,100
تو سارے تو نہیں بھاگ سکتے

2106
01:00:44,100 --> 01:00:46,080
گھر کا ایک ہی فرد بھاگے گا

2107
01:00:46,080 --> 01:00:48,080
تو وہ بھاگ کے ڈالر کاما کے پیچھے دیتا رہے

2108
01:00:48,080 --> 01:00:49,940
اور ہم اور سیز کو بس یوں یوں کرتے رہے

2109
01:00:49,940 --> 01:00:51,280
ٹھیک ہے نا یہ یہ ہے

2110
01:00:51,280 --> 01:00:52,720
وہاں سے ڈالر ہے اور ملک چلے

2111
01:00:52,720 --> 01:00:54,160
ایسے نہیں چلتا ملک

2112
01:00:54,160 --> 01:00:55,700
ریمیٹنسز پر ملک چلتا ہی

2113
01:00:55,700 --> 01:00:56,620
چل ہی نہیں سکتا بھائی

2114
01:00:56,620 --> 01:00:57,400
سوال ہی نہیں پسند ہے

2115
01:00:57,400 --> 01:00:58,340
انڈسٹری سے چلتا ہے

2116
01:00:58,340 --> 01:01:00,680
انڈسٹری ہماری پرائرٹی نہیں ہے

2117
01:01:00,680 --> 01:01:02,620
تو اگر انڈسٹری آپ کو لگتا ہے

2118
01:01:02,620 --> 01:01:03,520
ہماری پرائرٹی ہے

2119
01:01:03,520 --> 01:01:05,520
تو جو لوگ کراچی میں بیٹھے ہیں

2120
01:01:05,520 --> 01:01:07,080
خدا کے واسطے اپنی گاڑی

2121
01:01:07,080 --> 01:01:08,380
بلکہ اپنی بائیک نکالیں

2122
01:01:08,380 --> 01:01:09,120
اگر بائیک ہے تو

2123
01:01:09,120 --> 01:01:11,660
اور سائٹ ایریا جو اس ملک کی

2124
01:01:11,660 --> 01:01:13,420
سب سے بڑی انڈسٹریل سائٹ ہے

2125
01:01:13,420 --> 01:01:15,400
وہاں پہ بائیک چلا کے دکھائیں

2126
01:01:15,400 --> 01:01:17,080
اتنا بڑا بڑا خڑہ ہے وہاں پہ

2127
01:01:17,080 --> 01:01:19,340
وہاں سے آپ کے پورے ملک کے گوڈز

2128
01:01:19,340 --> 01:01:20,680
مو فورڈ ہوتے ہیں

2129
01:01:20,680 --> 01:01:21,920
لیکن پورٹ سے آتے ہیں وہاں پہ

2130
01:01:21,920 --> 01:01:23,440
اور پھر وہاں سے مو فورڈ

2131
01:01:23,440 --> 01:01:27,480
جب آپ کے ملک میں ٹرک ہی نہیں چل پائے گا

2132
01:01:27,480 --> 01:01:29,220
یا وہ اتنے بڑے بڑے خڑوں سے

2133
01:01:29,220 --> 01:01:30,700
ڈیمیج ہوتا رہے گا تو

2134
01:01:30,700 --> 01:01:31,840
کاؤسٹ نہیں بڑے گی اس کی

2135
01:01:31,840 --> 01:01:34,000
بار بار اس کا ایکسل ٹوٹے گا

2136
01:01:34,000 --> 01:01:35,600
گاڑی کا ویرنٹ ائر ہوگا

2137
01:01:35,600 --> 01:01:37,420
کیا بات کرتے ہو یار

2138
01:01:37,420 --> 01:01:39,120
چھوڑو یار میں تو

2139
01:01:39,120 --> 01:01:41,780
بات ہی نہیں کرتا اس طرح

2140
01:01:41,780 --> 01:01:43,740
خیر تو بھائی ہر ملک کی

2141
01:01:43,740 --> 01:01:45,940
اپنی پالسی ہوتی ہے سعودی عربیہ

2142
01:01:45,940 --> 01:01:47,380
کا اپنا پلان ہے ٹوئنی تھرٹی کا

2143
01:01:47,380 --> 01:01:48,340
اور وہ کر بھی لیں گے

2144
01:01:48,340 --> 01:01:50,400
ہمارے ملک کا پلان کیا ہے

2145
01:01:50,400 --> 01:01:54,280
آپ جتنے بھی لوگ بیٹھے سن رہے ہیں

2146
01:01:54,280 --> 01:01:56,460
آپ کا اپنی زندگی میں ایک پلان ہے نا

2147
01:01:56,460 --> 01:01:57,920
کہ یار ابھی میں اٹھارہ کہوں پھر میں

2148
01:01:57,920 --> 01:02:00,080
کمیوڈر سائنسز پڑھوں گا پھر میں سوفیر انجینئر

2149
01:02:00,080 --> 01:02:01,880
بننا ہے میں نے یہاں کام کرنا ہے پھر یہاں سے

2150
01:02:01,880 --> 01:02:04,080
میں نے پھر کسی طرح دوبائی نکل جانا ہے

2151
01:02:04,080 --> 01:02:06,320
پھر میں نے کسی طرح جرمنی کا کورس پکڑ لینا ہے

2152
01:02:06,320 --> 01:02:08,500
وغیرہ وغیرہ کر کے پلان ہوتا نا

2153
01:02:08,500 --> 01:02:10,420
اور پھر ہم اس پلان پہ کام کرتے ہیں

2154
01:02:10,420 --> 01:02:12,040
کچھ لوگ کامیاب ہو جاتے ہیں کچھ لوگ

2155
01:02:12,040 --> 01:02:14,020
نہیں کر پاسے بلیس ٹرائے تو کرتے ہیں

2156
01:02:14,020 --> 01:02:16,000
پاکستان کا پلان کیا ہے

2157
01:02:16,000 --> 01:02:17,920
مجھے یہ بتائیں پاکستان نے کرنا کیا ہے

2158
01:02:17,920 --> 01:02:19,920
ہم ایک اسلامیک

2159
01:02:19,920 --> 01:02:22,100
ویلفیر سٹیٹ بنیں گے کیسے

2160
01:02:22,100 --> 01:02:24,300
یہ نہیں بتائیں گے بنیں گے

2161
01:02:24,300 --> 01:02:26,600
کب نہیں پتا بنیں گے

2162
01:02:26,600 --> 01:02:28,000
کوئی پلان آف ایکشن نہیں

2163
01:02:28,000 --> 01:02:30,080
کیونکہ ہم پوچھتے ہیں نا اکاؤنٹیبلیٹی

2164
01:02:30,080 --> 01:02:32,040
نہیں ابھی جیسے پچھلے سوال میں میں کہہ رہا تھا نا

2165
01:02:32,720 --> 01:02:33,720
آپ کا نوکر ہوتا ہے یار

2166
01:02:33,720 --> 01:02:35,580
ایم این ایم پی اے وہ نوکری لینے آتا ہے

2167
01:02:35,580 --> 01:02:37,460
آپ نے اس سے ڈاکیومنٹس لینے کہ بیٹا

2168
01:02:37,460 --> 01:02:39,300
ذرا دیکھا تو اس قابل ہے آپ

2169
01:02:39,300 --> 01:02:40,640
الٹا اس کو بولتے ہو ہاں لے

2170
01:02:40,640 --> 01:02:42,880
اس سے زیادہ ہم ٹیکس دے رہے ہوتے ہیں

2171
01:02:42,880 --> 01:02:44,620
پرکس وہ لے رہا ہوتا ہے

2172
01:02:44,620 --> 01:02:46,980
ٹیکس ہم بھریں وہ تو ٹیکس بھی نہیں دیتا

2173
01:02:46,980 --> 01:02:48,900
اور پروٹوکول میں وہ ہی گھومتا ہے

2174
01:02:48,900 --> 01:02:51,360
عجیب سسٹم ہے یار اکاؤنٹیبلیٹی نہیں ہے

2175
01:02:51,360 --> 01:02:53,380
تو جب آپ نے اکاؤنٹیبلیٹی ہی نہیں کرنی

2176
01:02:53,380 --> 01:02:54,660
اور شخصیت پہ

2177
01:02:54,660 --> 01:02:57,440
یا برادری پہ یا ذات پات پہ ووٹ کرنا ہے

2178
01:02:57,440 --> 01:02:59,600
تو اللہ تو آپ کو ایکسپلویٹی کرے گا نا

2179
01:02:59,600 --> 01:03:01,800
جب مجھے پتا ہے کہ مجھے کام کیے

2180
01:03:01,800 --> 01:03:03,780
بغیر آپ نے مجھے ووٹ دینا ہے

2181
01:03:03,780 --> 01:03:05,260
تو میں کام کیوں کروں گا

2182
01:03:05,260 --> 01:03:06,920
گر میں پوائنٹ

2183
01:03:06,920 --> 01:03:09,360
ہم اکاؤنٹیبلیٹی نہیں کرتے

2184
01:03:09,360 --> 01:03:11,640
ہم اپنی بھی نہیں کرتے نا مسئلہ سارا ہی ہے

2185
01:03:11,640 --> 01:03:13,600
ہم اپنی بھی اکاؤنٹیبلیٹی نہیں کرتے

2186
01:03:13,600 --> 01:03:15,180
تو ہم دوسرے کی کیا کریں گے

2187
01:03:15,180 --> 01:03:17,660
ہاں دوسرے کو دوزخ دکھانے میں آتی ہے

2188
01:03:17,660 --> 01:03:19,860
مگر اس دنیا کو دوزخ بنا رہے ہیں

2189
01:03:19,860 --> 01:03:20,940
یہ دکھانا نہیں آتا

2190
01:03:20,940 --> 01:03:23,760
تو یار ایزا نیشن ہمارا کوئی پلان نہیں ہے

2191
01:03:23,760 --> 01:03:24,900
ہمارا پلان بس یہ ہے

2192
01:03:24,900 --> 01:03:27,020
اسرائیل تباہ کرنا ہے اور انڈیا تباہ کرنا ہے

2193
01:03:27,020 --> 01:03:29,180
وہ ہو نہیں سکتا آج کے دور میں

2194
01:03:29,180 --> 01:03:31,220
آج کے دور میں اتنی سینکشنز لگیں گی نا

2195
01:03:31,220 --> 01:03:32,540
آپ کر ہی نہیں سکتے

2196
01:03:32,540 --> 01:03:33,860
آپ وار پہ جائیں نہیں سکتے

2197
01:03:33,860 --> 01:03:35,620
پس پیسے چاہیے ہوتے ہیں وار کے لیے

2198
01:03:35,620 --> 01:03:38,040
جرمنی دیکھیں نا

2199
01:03:38,040 --> 01:03:41,820
ان اٹھارہ سو اکتر میں وہ یونائٹ ہوا

2200
01:03:41,820 --> 01:03:44,200
اور انہوں نے ایکنومک پاور بنے

2201
01:03:44,200 --> 01:03:47,340
انیس سو میں انہوں نے تیزی سے انڈسٹریلائزیشن کی

2202
01:03:47,340 --> 01:03:48,880
اس کے بھی چودہ سال بعد

2203
01:03:48,880 --> 01:03:50,520
ورلڈ وار ون پہ گئے وہ

2204
01:03:50,520 --> 01:03:51,540
سمجھ رہے ہیں

2205
01:03:51,540 --> 01:03:53,640
تو ہم کیا ہی لڑ لیں گے بھائی

2206
01:03:53,640 --> 01:03:55,640
چار دن کا پیٹرول نہیں ہوگا ہمارے پاس

2207
01:03:55,640 --> 01:03:57,380
سعودی وہاں سے یوں بن کرے گا

2208
01:03:57,380 --> 01:03:58,440
پھر کیا لڑیں گے ہم

2209
01:03:58,440 --> 01:03:59,300
خیر

2210
01:03:59,300 --> 01:04:00,680
تو بھائی

2211
01:04:00,680 --> 01:04:02,360
پوائنٹ بینگ

2212
01:04:02,360 --> 01:04:04,120
کہ ملک اور قومیں

2213
01:04:04,120 --> 01:04:05,900
ایک روڈ میپ ہوتا ہے

2214
01:04:05,900 --> 01:04:06,600
ایک ویژن ہوتا ہے

2215
01:04:06,600 --> 01:04:07,600
کہ ہم نے یہاں جانا ہے

2216
01:04:07,600 --> 01:04:08,460
یہ ہماری منزل ہے

2217
01:04:08,460 --> 01:04:10,900
اور اس منزل کے لئے ہمیں یہ پاتھ کرنا ہے

2218
01:04:10,900 --> 01:04:12,720
ہمیں پتہ ہی نہیں ہماری منزل کیا ہے

2219
01:04:12,720 --> 01:04:14,460
کبھی منزل ہماری سعودی عرب تھی

2220
01:04:14,460 --> 01:04:15,820
کبھی ٹرکی ہو جاتی ہے

2221
01:04:15,820 --> 01:04:17,100
کبھی ملیشیا ہو جاتی ہے

2222
01:04:17,100 --> 01:04:19,400
ہمارے تو وہ گول پوسٹ ہی چینج ہوتے رہتے ہیں

2223
01:04:19,400 --> 01:04:22,300
جب پتہ ہی نہیں گول کرنا کہاں ہے

2224
01:04:22,300 --> 01:04:23,140
وہ چینج ہوتا رہتا ہے

2225
01:04:23,140 --> 01:04:24,320
تو آپ کہاں ہی بول مارو گے

2226
01:04:24,320 --> 01:04:25,680
ہم بول لے کے بس کھڑے ہیں

2227
01:04:25,680 --> 01:04:27,480
اور اپنی بولے لے کے کھڑے ہیں

2228
01:04:27,480 --> 01:04:28,480
تو

2229
01:04:28,480 --> 01:04:30,420
ہم نہیں ہماری مستقبلی ہے

2230
01:04:30,420 --> 01:04:31,120
اب آپ کو لگے گا

2231
01:04:31,120 --> 01:04:32,420
جی آپ مایوسی کی بات کرتے ہیں

2232
01:04:32,420 --> 01:04:33,620
ڈپریشن کی بات کرتے ہیں

2233
01:04:33,620 --> 01:04:35,880
یار فیکٹس اور فگرز ہیں آپ کے سامنے

2234
01:04:35,880 --> 01:04:37,860
اگر آپ کو اس میں بھی

2235
01:04:37,860 --> 01:04:38,780
وہی والی بات ہے نا

2236
01:04:38,780 --> 01:04:40,260
آپ کو نیشنلزم کہتا ہے نا

2237
01:04:40,260 --> 01:04:40,800
چورن

2238
01:04:40,800 --> 01:04:43,180
سنگھایا ہے ناک کے ذریعے

2239
01:04:43,180 --> 01:04:44,820
آپ کو نظر ہی نہیں آتا

2240
01:04:44,820 --> 01:04:46,720
آپ کو نظر آئے گا جب آپ جیسے یہ بھائی ہیں

2241
01:04:46,720 --> 01:04:48,080
سعودی میں کام کرتے تھے

2242
01:04:48,080 --> 01:04:48,900
انہوں نے گروت دیکھی

2243
01:04:48,900 --> 01:04:49,780
اب کینیڈا چلے گئے

2244
01:04:49,780 --> 01:04:51,480
گروت پرو میکس دیکھ رہے ہیں

2245
01:04:51,480 --> 01:04:52,500
اب آپ جہاں بیٹھے ہیں

2246
01:04:52,500 --> 01:04:53,540
وہیں بیٹھے ساری زندگی

2247
01:04:53,540 --> 01:04:54,660
جوہر میں ہی اگر گزار دی

2248
01:04:54,660 --> 01:04:56,100
تو کیا ہی پروگرس دیکھ لی

2249
01:04:56,100 --> 01:04:57,940
کہ دنیا میں لوگ رہتے کیسے ہیں

2250
01:04:57,940 --> 01:05:00,320
دنیا میں لوگ کتنی عزت سے روڈ کروس کرتے ہیں

2251
01:05:00,320 --> 01:05:02,620
جس دن تم نے یہ ایکسپیرینس کر لیا نا

2252
01:05:02,620 --> 01:05:03,760
ہماری زندگی بدل جائے گی

2253
01:05:03,760 --> 01:05:04,480
یہاں اسامہ بھائی

2254
01:05:04,480 --> 01:05:06,900
مانتے ہو اس بات کو

2255
01:05:06,900 --> 01:05:08,320
سر پکڑ لیتا ہے بھائی بندہ

2256
01:05:08,320 --> 01:05:09,940
ابھی اتنی عزت سے روڈ کروس کر رہے ہیں

2257
01:05:09,940 --> 01:05:13,000
ابھی آپ نے عزت ایکسپیرینس ہی نہیں کیا

2258
01:05:13,000 --> 01:05:14,420
کہ انسان کی زندگی

2259
01:05:14,420 --> 01:05:16,420
وہ نیوزیلینڈ میں جب واقعہ ہوا تھا نا

2260
01:05:16,420 --> 01:05:17,160
کرائس چرچ والا

2261
01:05:17,160 --> 01:05:18,120
اس کے بعد ویڈیوز کی نا

2262
01:05:18,120 --> 01:05:19,520
اگلے دو دو ہفتے تک لڑکیاں کے

2263
01:05:19,520 --> 01:05:21,440
سسک سسک کے رو رہی تھی

2264
01:05:21,440 --> 01:05:22,660
وہ اس لیے رو رہی تھی

2265
01:05:22,660 --> 01:05:24,760
کہ وہاں یہ چیزیں ہوتی نہیں ہیں

