# All large local runtime artifacts: models, caches, reports, backups and logs
/.cache/

# Legacy runtime locations (keep ignored if recreated)
/all_episodes/
/models/
/reports/
/backups/
/logs/
/CrisperWhisper2_Large/

# Model weights and binary training artifacts, wherever downloaded
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx
*.gguf
*.ggml
*.bin
*.h5
*.hdf5
*.npz
*.npy
# The Ganji model's own weights are small and belong to this project
!/ganji-model/weights/*.npz

# Source media, such as a new episode's audio while it waits in the root folder (transcript .srt files remain versioned)
*.mp3
*.wav
*.flac
*.m4a
*.aac
*.ogg
*.mp4
*.mkv
*.webm
*.mov

# Compressed backups and downloads
*.zip
*.7z
*.tar
*.tar.gz
*.tgz
*.tar.xz
*.gz

# Environments and temporary files
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.tmp
*.temp
*.part
*.log
.ct2-batch.lock

# Editors and operating systems
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
